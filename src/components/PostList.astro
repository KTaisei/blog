---
import type { CollectionEntry } from 'astro:content';
const { posts } = Astro.props as { posts: CollectionEntry<'posts'>[] };
---
<ul class="post-list">
  {posts.map((post) => <li class="post-card"><div class="meta"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('ja-JP')}</time></div><h2><a href={`${import.meta.env.BASE_URL}posts/${post.id}/`}>{post.data.title}</a></h2>{post.data.description && <p class="summary">{post.data.description}</p>}<ul class="tags">{post.data.tags.map((tag) => <li><a class="tag" href={`${import.meta.env.BASE_URL}tags/${encodeURIComponent(tag)}/`}>{tag}</a></li>)}</ul></li>)}
</ul>
