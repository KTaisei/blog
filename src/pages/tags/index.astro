---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro';
const posts = await getCollection('posts', ({ data }) => !data.draft); const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---
<BaseLayout title="タグ | taisei.dev"><section class="page-heading"><p class="eyebrow">Explore</p><h1>タグ</h1><p>興味のあるテーマから記事を探せます。</p></section><ul class="tags">{tags.map((tag) => <li><a class="tag" href={`${import.meta.env.BASE_URL}tags/${encodeURIComponent(tag)}/`}>{tag}</a></li>)}</ul></BaseLayout>
