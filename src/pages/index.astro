---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="my blog"><section class="page-heading"><h1 class="eyebrow">Notes & stories</h1></section><PostList {posts} /></BaseLayout>
